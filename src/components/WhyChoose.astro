---
import ContentImage from './ContentImage.astro';
import why1 from '../assets/why-01.avif';
import why2 from '../assets/why-02.avif';
import why3 from '../assets/why-03.avif';

const items = [
  {
    img: why1,
    title: 'Reach a Global Audience',
    text: 'Showcase your research without the constraints of traditional journals.',
    gridId: 'afa9e7ea-a8fa-34c3-4529-3be2b1902d33',
    slideId: 'a5b65254-33ad-a854-2870-deec45e73288',
  },
  {
    img: why2,
    title: 'Build Your Professional Profile',
    text: 'Gain credibility and career opportunities through a democratic review process.',
    gridId: 'afa9e7ea-a8fa-34c3-4529-3be2b1902d3a',
    slideId: 'f58f6f64-739c-d4a4-e5d4-b6e66f0f4c8d',
  },
  {
    img: why3,
    title: 'Break Free from Gatekeepers',
    text: 'Publish innovative work without restrictions or barriers.',
    gridId: 'afa9e7ea-a8fa-34c3-4529-3be2b1902d41',
    slideId: '936bd45b-cbd4-95c5-8698-45abffc85591',
  },
];

const widths = [371, 560, 742];
---

<div id="w-node-_6da26ae7-d9a1-5324-13ae-73644f8f6f63-042a594c" data-w-id="6da26ae7-d9a1-5324-13ae-73644f8f6f63" class="wide-deco-blue-line"></div>
<h2 data-w-id="fe0f64b5-a4e2-2e19-4224-9ce10836ae4b" class="h2 center bm-52">
  Why <span class="blue-span">Choose</span> Odd Academia?
</h2>

<!-- Desktop / tablet: three columns -->
<div class="w-layout-grid _5-col-grid mob-hdn">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <div class="vert-deco-black-line" />}
        <div data-w-id={item.gridId} class="one-parts-wrap">
          <ContentImage src={item.img} width={371} widths={widths} sizes="371px" class="why-img" />
          <div class="one-parts-text-wrap">
            <h3 class="h3 bm-12">{item.title}</h3>
            <div class="_18-150 _70">{item.text}</div>
          </div>
        </div>
      </>
    ))
  }
</div>

<div class="w-embed">
  <style is:inline>
.w-slider-nav-invert>div.w-active {
background: #0661FF;
}
.w-slider-nav-invert>div {
background: #CCE0FF;
}
</style>
</div>

<!-- Mobile: Webflow slider -->
<div
  data-delay="4000"
  data-animation="slide"
  class="slider w-slider"
  data-autoplay="false"
  data-easing="ease"
  data-hide-arrows="false"
  data-disable-swipe="false"
  data-autoplay-limit="0"
  data-nav-spacing="3"
  data-duration="500"
  data-infinite="true"
>
  <div class="w-slider-mask">
    {
      items.map((item) => (
        <div class="slide w-slide">
          <div data-w-id={item.slideId} class="one-parts-wrap">
            <ContentImage
              src={item.img}
              width={371}
              widths={widths}
              sizes="(max-width: 479px) 78vw, 371px"
              class="why-img"
            />
            <div class="one-parts-text-wrap">
              <h3 class="h3 bm-12 mob-20">{item.title}</h3>
              <div class="_18-150 _70 mob-left">{item.text}</div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="left-arrow w-slider-arrow-left">
    <div class="w-icon-slider-left"></div>
  </div>
  <div class="right-arrow w-slider-arrow-right">
    <div class="w-icon-slider-right"></div>
  </div>
  <div class="slider-nav w-slider-nav w-slider-nav-invert w-round"></div>
</div>
